[Unit]
Description=Dispatch scheduled commands that have come due

[Service]
Type=oneshot
ExecStart=%h/.local/bin/crontinental tick

# The tick never RUNS a job -- it launches each one as its own transient unit
# (`systemd-run --user`, unit crontinental-job-<name>.service) and returns. So
# this timeout bounds bookkeeping only, and no job, however long or wedged, can
# hold the tick or delay another job. Each job carries its own RuntimeMaxSec.
TimeoutStartSec=45s

# Jobs inherit nothing from here: they are started fresh by the user manager and
# run under `bash -lc`, so their PATH is the login shell's (nvm, mise,
# ~/.local/bin) rather than systemd's bare one -- the trap that would otherwise
# make every node-touching job die only when scheduled.
